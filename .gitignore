# --- Secrets & per-instance config (NEVER commit) ---
config.json
config.json.before-*.bak
config.json.pre-*.bak
*.before-*.bak
*.pre-*.bak
*.pre_*.bak
*.bak
*.tmp

# --- Runtime state / toggles ---
execute_record.json
.plugin_state.json
state.json
.toggle-*
.disabled

# --- Logs & runtime-generated data ---
*.log
proxy.log
logs/
data/
.cache/

# --- Generated / large artifacts ---
cache/
stats/
stats.db
ccr/
ccr.db
cr/ccr.db
staging/
# Whole-file pre-adopt snapshots (helpers/fragment_store.snapshot_default).
# Runtime state, same class as staging/ and logs/. Gitignore it wholesale
# rather than per-prefix: the directory accumulates one entry per adopt AND
# per test run, and a partial pattern let ~400 test-generated directories
# show up as untracked noise. Never commit a snapshot - it is a copy of a live
# user skill file.
fragments/
# Trained reward-model artifacts (267 MB model.safetensors + tokenizer).
# Whole dir is generated output; keep it out of git. See AGENTS.md v1.8.0.
models/

